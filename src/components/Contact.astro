---
import { site } from '../data/site';

/*
 * No contact form. A static site has no backend to receive one, and a form
 * that silently does nothing is worse than a link. Email, GitHub and (once the
 * URL is set) LinkedIn are the whole section.
 */

/*
 * Email and LinkedIn only. GitHub is already in the hero and the footer, and
 * a third card here made the section read as a link dump rather than a way to
 * reach me. No phone number: a number on a public page gets scraped, and
 * recruiters open a conversation by email or LinkedIn. It is on the CV, which
 * goes to people who are actually hiring.
 */
const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
  ...(site.linkedin
    ? [{ label: 'LinkedIn', value: 'LinkedIn profile', href: site.linkedin, external: true }]
    : []),
];
---

<div class="contact">
  <p class="lead measure">
    Email is quickest. Happy to walk through any of these projects in detail, including the
    unfinished parts.
  </p>

  <ul class="channels">
    {
      channels.map((channel) => (
        <li class="card">
          <span class="label">{channel.label}</span>
          <a
            href={channel.href}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener noreferrer' : undefined}
          >
            {channel.value}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="faint note measure">{site.availability}</p>
</div>

<style>
  .lead {
    color: var(--text-muted);
  }

  .channels {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (min-width: 40rem) {
    .channels {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-4);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.77rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  li a {
    font-size: 0.95rem;
    font-weight: 500;
    word-break: break-word;
  }

  .note {
    margin-top: var(--space-5);
    font-size: 0.86rem;
  }
</style>
