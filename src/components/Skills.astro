---
import { skillGroups } from '../data/skills';

/*
 * Three columns, each a heading and a set of chips. No cards and no
 * explanatory copy: this is meant to be read in a glance, and the depth lives
 * in the case studies. Chips reuse the site's existing `.tag` style so the
 * section does not read as a separate badge collection.
 */
---

<div class="groups">
  {
    skillGroups.map((group) => (
      <section class="group">
        <h3>{group.title}</h3>
        <ul class="tags">
          {group.items.map((item) => (
            <li class="tag">{item}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    gap: var(--space-6) var(--space-5);
  }

  @media (min-width: 46rem) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .group {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-strong);
  }

  h3 {
    font-family: var(--font-mono);
    font-size: 0.79rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: var(--space-4);
  }

  /* Slightly roomier than the card tags, since these carry the section. */
  .tags {
    gap: var(--space-2);
  }

  .tag {
    padding: 0.3rem 0.62rem;
    color: var(--text);
    background: var(--surface);
    font-size: 0.81rem;
    white-space: normal;
  }
</style>
